function deleteTeacher_(payload){const ctx=requireSuperAdmin_(payload.token),id=String(payload.userId||''),user=findRowByKey_('USERS','userId',id);if(!user||String(user.role)!=='teacher')throw apiError_('Guru tidak ditemukan.','NOT_FOUND');if(rows_('EXAMS').some(e=>String(e.ownerId)===id))throw apiError_('Guru masih memiliki ujian. Pindahkan atau hapus ujian terlebih dahulu.','TEACHER_IN_USE');deleteRowByKey_('USERS','userId',id);audit_(ctx.user.userId,'DELETE_TEACHER',id,{});return null;}
function listUsers_(payload){requireSuperAdmin_(payload.token);return rows_('USERS').map(sanitizeUser_);}
function saveUser_(payload){const ctx=requireSuperAdmin_(payload.token),input=payload.input||{},role=String(input.role||'student');if(['super_admin','teacher','student'].indexOf(role)<0)throw apiError_('Role tidak valid.','BAD_REQUEST');if(role==='teacher')return saveTeacher_({token:payload.token,input:input});if(role==='student')return saveStudent_({token:payload.token,input:input});const id=String(input.userId||uid_('SA')),now=nowIso_(),existing=findRowByKey_('USERS','userId',id),duplicate=rows_('USERS').find(u=>String(u.username).toLowerCase()===String(input.username).toLowerCase()&&String(u.userId)!==id);if(duplicate)throw apiError_('Username sudah digunakan.','DUPLICATE_USERNAME');if(!input.name||!input.username)throw apiError_('Nama dan username wajib diisi.','BAD_REQUEST');const salt=existing?String(existing.passwordSalt):Utilities.getUuid(),passwordHash=input.password?hashPassword_(input.password,salt):(existing?existing.passwordHash:'');if(!passwordHash)throw apiError_('Password wajib untuk akun baru.','BAD_REQUEST');const obj={userId:id,name:String(input.name),email:String(input.email||''),phone:String(input.phone||''),className:'',subject:'',username:String(input.username),passwordHash,passwordSalt:salt,role:'super_admin',status:String(input.status||'ACTIVE'),createdAt:existing?existing.createdAt:now,updatedAt:now};if(existing)updateRowByKey_('USERS','userId',id,obj);else appendObject_('USERS',obj);audit_(ctx.user.userId,'SAVE_USER',id,{role});return sanitizeUser_(findRowByKey_('USERS','userId',id));}
function deleteUser_(payload){const ctx=requireSuperAdmin_(payload.token),id=String(payload.userId||''),user=findRowByKey_('USERS','userId',id);if(!user)throw apiError_('User tidak ditemukan.','NOT_FOUND');if(String(user.userId)===String(ctx.user.userId))throw apiError_('Akun Super Admin yang sedang digunakan tidak dapat dihapus.','SELF_DELETE');if(String(user.role)==='teacher')return deleteTeacher_(payload);if(String(user.role)==='student')return deleteStudent_(payload);deleteRowByKey_('USERS','userId',id);audit_(ctx.user.userId,'DELETE_USER',id,{});return null;}
function getMonitoring_(payload){const ctx=requireManager_(payload.token),allowed={};visibleExamsFor_(ctx).forEach(e=>allowed[String(e.examId)]=true);const users=rows_('USERS'),exams=rows_('EXAMS');return rows_('ATTEMPTS').filter(a=>allowed[String(a.examId)]&&(!payload.examId||String(a.examId)===String(payload.examId))).map(a=>{const u=users.find(x=>String(x.userId)===String(a.studentId))||{},e=exams.find(x=>String(x.examId)===String(a.examId))||{};return{attemptId:String(a.attemptId),studentId:String(a.studentId),studentName:String(u.name||a.studentId),className:String(u.className||''),examId:String(a.examId),examTitle:String(e.title||a.examId),status:String(a.status),startedAt:a.startedAt?new Date(a.startedAt).toISOString():'',lastSyncAt:a.lastSyncAt?new Date(a.lastSyncAt).toISOString():'',revision:Number(a.revision||0),submittedAt:a.submittedAt?new Date(a.submittedAt).toISOString():undefined};});}
function getAdminResults_(payload){const ctx=requireManager_(payload.token),allowed={};visibleExamsFor_(ctx).forEach(e=>allowed[String(e.examId)]=true);const users=rows_('USERS'),exams=rows_('EXAMS');return rows_('SUBMISSIONS').filter(s=>allowed[String(s.examId)]&&(!payload.examId||String(s.examId)===String(payload.examId))).map(s=>{const u=users.find(x=>String(x.userId)===String(s.studentId))||{},e=exams.find(x=>String(x.examId)===String(s.examId))||{};return{submissionId:String(s.submissionId),attemptId:String(s.attemptId),studentId:String(s.studentId),studentName:String(u.name||s.studentId),className:String(u.className||''),examId:String(s.examId),examTitle:String(e.title||s.examId),score:Number(s.score||0),correctCount:Number(s.correctCount||0),wrongCount:Number(s.wrongCount||0),blankCount:Number(s.blankCount||0),submittedAt:new Date(s.submittedAt).toISOString()};});}
