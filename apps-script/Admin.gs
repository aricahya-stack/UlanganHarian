function importQuestionsCsv_(payload){const ctx=requireManager_(payload.token),text=String(payload.csvText||'').trim();if(!text)return{imported:0,errors:['CSV kosong.']};const lines=text.split(/\r?\n/),headers=parseCsvLine_(lines.shift()).map(h=>h.trim()),errors=[];let imported=0;for(let i=0;i<lines.length;i++){if(!lines[i].trim())continue;const values=parseCsvLine_(lines[i]),row={};headers.forEach((h,j)=>row[h]=values[j]||'');try{const exam=findRowByKey_('EXAMS','examId',row.examId);assertManageExam_(ctx,exam);saveQuestion_({token:payload.token,input:{examId:row.examId,questionText:row.questionText,optionA:row.optionA,optionB:row.optionB,optionC:row.optionC,optionD:row.optionD,correctAnswer:row.correctAnswer,score:Number(row.score||1),difficulty:row.difficulty||'Sedang',tag:row.tag||'',status:'ACTIVE'}});imported++}catch(e){errors.push('Baris '+(i+2)+': '+e.message)}}audit_(ctx.user.userId,'IMPORT_QUESTIONS','',{imported,errors:errors.length});return{imported,errors};}
function parseCsvLine_(line){const out=[];let cur='',quoted=false;for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'){if(quoted&&line[i+1]==='"'){cur+='"';i++}else quoted=!quoted}else if(ch===','&&!quoted){out.push(cur);cur=''}else cur+=ch}out.push(cur);return out;}
