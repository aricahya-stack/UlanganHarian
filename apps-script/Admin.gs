  const attempts=rows_('ATTEMPTS').filter(a=>examIds[String(a.examId)]),students=rows_('USERS').filter(u=>String(u.role)==='student'&&String(u.status)==='ACTIVE');
  return{activeExams:exams.filter(e=>new Date(e.startTime).getTime()<=now&&new Date(e.endTime).getTime()>=now&&['PUBLISHED','ACTIVE'].indexOf(String(e.status))>=0).length,upcomingExams:exams.filter(e=>new Date(e.startTime).getTime()>now&&['PUBLISHED','ACTIVE'].indexOf(String(e.status))>=0).length,students:students.length,inProgress:attempts.filter(a=>String(a.status)==='IN_PROGRESS').length,submitted:attempts.filter(a=>String(a.status)==='SUBMITTED').length,notSubmitted:Math.max(0,students.length-attempts.filter(a=>String(a.status)==='SUBMITTED').length)};
