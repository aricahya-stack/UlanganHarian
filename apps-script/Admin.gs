function duplicateExam_(payload){const ctx=requireManager_(payload.token),src=findRowByKey_('EXAMS','examId',payload.examId);assertManageExam_(ctx,src);const newId=uid_('EX'),now=nowIso_(),copy={};SM.SHEETS.EXAMS.forEach(h=>copy[h]=src[h]);copy.examId=newId;copy.ownerId=String(ctx.user.role)==='teacher'?ctx.user.userId:src.ownerId;copy.title=String(src.title)+' (Salinan)';copy.status='DRAFT';copy.createdAt=now;copy.updatedAt=now;appendObject_('EXAMS',copy);const map={},questions=rows_('QUESTIONS').filter(q=>String(q.examId)===String(src.examId));questions.forEach(q=>{const newQ=uid_('Q');map[String(q.questionId)]=newQ;appendObject_('QUESTIONS',{questionId:newQ,examId:newId,questionText:q.questionText,optionA:q.optionA,optionB:q.optionB,optionC:q.optionC,optionD:q.optionD,imageFileId:q.imageFileId||'',questionType:q.questionType||'MULTIPLE_CHOICE',difficulty:q.difficulty||'Sedang',tag:q.tag||'',status:q.status||'ACTIVE',createdAt:now,updatedAt:now});});const keys=rows_('ANSWER_KEYS');Object.keys(map).forEach(oldId=>{const k=keys.find(x=>String(x.questionId)===oldId);if(k)appendObject_('ANSWER_KEYS',{questionId:map[oldId],correctAnswer:k.correctAnswer,score:k.score});});audit_(ctx.user.userId,'DUPLICATE_EXAM',newId,{source:src.examId});return normalizeExamRecord_(findRowByKey_('EXAMS','examId',newId));}
function listQuestions_(payload){const ctx=requireManager_(payload.token),allowed={};visibleExamsFor_(ctx).forEach(e=>allowed[String(e.examId)]=true);const keys=rows_('ANSWER_KEYS');return rows_('QUESTIONS').filter(q=>allowed[String(q.examId)]&&(!payload.examId||String(q.examId)===String(payload.examId))).map(q=>{const k=keys.find(x=>String(x.questionId)===String(q.questionId));return{questionId:String(q.questionId),examId:String(q.examId),questionText:String(q.questionText),optionA:String(q.optionA),optionB:String(q.optionB),optionC:String(q.optionC),optionD:String(q.optionD),correctAnswer:k?String(k.correctAnswer):'',score:k?Number(k.score||1):1,imageFileId:String(q.imageFileId||''),imageUrl:q.imageFileId?drivePublicUrl_(String(q.imageFileId)):'',difficulty:String(q.difficulty||'Sedang'),tag:String(q.tag||''),status:String(q.status||'ACTIVE')}});}
function saveQuestion_(payload){const ctx=requireManager_(payload.token),input=payload.input||{},exam=findRowByKey_('EXAMS','examId',input.examId);assertManageExam_(ctx,exam);if(!input.questionText||!input.optionA||!input.optionB||!input.optionC||!input.optionD)throw apiError_('Soal dan empat pilihan wajib diisi.','BAD_REQUEST');if(['A','B','C','D'].indexOf(String(input.correctAnswer))<0)throw apiError_('Kunci jawaban harus A/B/C/D.','BAD_REQUEST');const id=String(input.questionId||uid_('Q')),now=nowIso_(),obj={questionId:id,examId:String(input.examId),questionText:String(input.questionText),optionA:String(input.optionA),optionB:String(input.optionB),optionC:String(input.optionC),optionD:String(input.optionD),imageFileId:String(input.imageFileId||''),questionType:'MULTIPLE_CHOICE',difficulty:String(input.difficulty||'Sedang'),tag:String(input.tag||''),status:String(input.status||'ACTIVE'),createdAt:now,updatedAt:now},existing=findRowByKey_('QUESTIONS','questionId',id);if(existing){const oldExam=findRowByKey_('EXAMS','examId',existing.examId);assertManageExam_(ctx,oldExam);obj.createdAt=existing.createdAt||now;updateRowByKey_('QUESTIONS','questionId',id,obj)}else appendObject_('QUESTIONS',obj);const key=findRowByKey_('ANSWER_KEYS','questionId',id),keyObj={questionId:id,correctAnswer:String(input.correctAnswer),score:Number(input.score||1)};if(key)updateRowByKey_('ANSWER_KEYS','questionId',id,keyObj);else appendObject_('ANSWER_KEYS',keyObj);audit_(ctx.user.userId,'SAVE_QUESTION',id,{examId:input.examId});return listQuestions_({token:payload.token,examId:input.examId}).find(q=>q.questionId===id);}
